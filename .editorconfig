root = true

# shfmt reads these settings; the gate runs shfmt over every owned shell script in both tiers.
# Values follow the harness catalogue's SHFMT.* rules.
[*.{sh,bash}]
indent_style = space
indent_size = 2
binary_next_line = true
switch_case_indent = true
function_next_line = false

# Git hooks are shell scripts without an extension.
[.githooks/*]
indent_style = space
indent_size = 2
binary_next_line = true
switch_case_indent = true
function_next_line = false
