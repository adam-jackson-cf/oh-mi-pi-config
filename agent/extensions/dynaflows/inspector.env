# Opt-in Jev Inspector route: omp's typesafe judge calls go through the local jev-bridge relay,
# which forwards them unchanged to TypeSafe and shows each request and answer in jev-inspector.
# jev-bridge listens on 127.0.0.1:8787 by default (github.com/diegoag64/jev-inspector, README at 27a3de3).
# Off by default. Opt in for one session:
#   env $(grep -v '^#' ~/.omp/agent/extensions/dynaflows/inspector.env) omp
# Gate judgments (structure_review, triage_advisories) refuse to run while TYPESAFE_BASE_URL is set.
TYPESAFE_BASE_URL=http://127.0.0.1:8787
