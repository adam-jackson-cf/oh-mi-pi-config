{
  "name": "python",
  "convention_sources": {
    "extensions": {
      ".py": "https://docs.python.org/3/tutorial/modules.html",
      ".pyi": "https://typing.python.org/en/latest/spec/distributing.html#stub-files"
    },
    "file": {
      "snake_case": "https://peps.python.org/pep-0008/#package-and-module-names"
    },
    "directory": {
      "snake_case": "https://peps.python.org/pep-0008/#package-and-module-names"
    },
    "package_marker": {
      "__init__.py": "https://docs.python.org/3/reference/import.html#regular-packages"
    },
    "stub_extension": {
      ".pyi": "https://typing.python.org/en/latest/spec/distributing.html#stub-files"
    },
    "class": {
      "PascalCase": "https://peps.python.org/pep-0008/#class-names"
    },
    "function": {
      "snake_case": "https://peps.python.org/pep-0008/#function-and-variable-names"
    },
    "framework_symbols": {
      "^(setUp|tearDown)(Class|Module)?$": "https://docs.python.org/3/library/unittest.html",
      "^async(SetUp|TearDown)$": "https://docs.python.org/3/library/unittest.html#unittest.IsolatedAsyncioTestCase",
      "^visit_[A-Za-z]+$": "https://docs.python.org/3/library/ast.html#ast.NodeVisitor",
      "^do_[A-Z]+$": "https://docs.python.org/3/library/http.server.html#http.server.BaseHTTPRequestHandler"
    },
    "fixed_files": {
      "__init__.py": "https://docs.python.org/3/reference/import.html#regular-packages",
      "__main__.py": "https://docs.python.org/3/library/__main__.html",
      "conftest.py": "https://docs.pytest.org/en/stable/reference/fixtures.html#conftest-py-sharing-fixtures-across-multiple-files"
    },
    "fixed_folders": {
      "__pycache__": "https://docs.python.org/3/tutorial/modules.html#compiled-python-files"
    },
    "ignored_folders": {
      "__pycache__": "https://docs.python.org/3/tutorial/modules.html#compiled-python-files",
      ".venv": "https://docs.python.org/3/library/venv.html",
      "venv": "https://docs.python.org/3/library/venv.html",
      "site-packages": "https://docs.python.org/3/library/site.html",
      ".tox": "https://tox.wiki/en/latest/config.html#work_dir",
      ".mypy_cache": "https://mypy.readthedocs.io/en/stable/config_file.html#confval-cache_dir",
      ".pytest_cache": "https://docs.pytest.org/en/stable/how-to/cache.html",
      ".ruff_cache": "https://docs.astral.sh/ruff/settings/#cache-dir"
    },
    "output_folders": {
      "build": "https://setuptools.pypa.io/en/latest/userguide/quickstart.html",
      "dist": "https://build.pypa.io/en/stable/"
    },
    "test_patterns": {
      "test_*.py": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery",
      "*_test.py": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery"
    },
    "test_like_patterns": {
      "test*.py": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery"
    },
    "placement": {
      "root": "agent/extensions/agent-rails/references/structure-and-naming.md#structure-and-grouping",
      "test_data_dirs": "https://jestjs.io/docs/snapshot-testing",
      "fixtures_dir": "agent/extensions/agent-rails/references/structure-and-naming.md#structure-and-grouping",
      "support_dir": "agent/extensions/agent-rails/references/structure-and-naming.md#structure-and-grouping",
      "beside_code": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery"
    },
    "test_support_files": {
      "conftest.py": "https://docs.pytest.org/en/stable/reference/fixtures.html#conftest-py-sharing-fixtures-across-multiple-files"
    },
    "test_frameworks": {
      "modules": "https://docs.python.org/3/library/unittest.html",
      "case_module": "https://docs.python.org/3/library/unittest.html#unittest.TestCase",
      "case_classes": "https://docs.python.org/3/library/unittest.html#unittest.IsolatedAsyncioTestCase",
      "class_prefix": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery",
      "function_prefix": "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery"
    },
    "comment_syntax": {
      "#": "https://docs.python.org/3/reference/lexical_analysis.html#comments"
    }
  },
  "convention_notes": [
    "PEP 8 casing is a recommendation; Python does not require that spelling.",
    "Directory casing applies to package directories only: PEP 8 names packages, and the import system imports a directory as a regular package through its __init__.py, so a directory of scripts is not a package.",
    "Test-like patterns identify near misses against the documented pytest discovery patterns, not additional pytest discovery rules.",
    "Test root, fixture and support names are harness defaults; pytest permits both separate and inline test layouts."
  ],
  "extensions": [".py", ".pyi"],
  "file": ["snake_case"],
  "directory": ["snake_case"],
  "package_marker": "__init__.py",
  "stub_extension": ".pyi",
  "class": ["PascalCase"],
  "function": ["snake_case"],
  "framework_symbols": [
    "^(setUp|tearDown)(Class|Module)?$",
    "^async(SetUp|TearDown)$",
    "^visit_[A-Za-z]+$",
    "^do_[A-Z]+$"
  ],
  "fixed_files": ["__init__.py", "__main__.py", "conftest.py"],
  "fixed_folders": ["__pycache__"],
  "ignored_folders": [
    "__pycache__",
    ".venv",
    "venv",
    "site-packages",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache"
  ],
  "output_folders": ["build", "dist"],
  "test_frameworks": {
    "modules": ["pytest", "unittest"],
    "case_module": "unittest",
    "case_classes": ["TestCase", "IsolatedAsyncioTestCase"],
    "class_prefix": "Test",
    "function_prefix": "test"
  },
  "test_patterns": ["test_*.py", "*_test.py"],
  "test_like_patterns": ["test*.py"],
  "sources": [
    "https://peps.python.org/pep-0008/#package-and-module-names",
    "https://docs.python.org/3/reference/import.html#regular-packages",
    "https://docs.python.org/3/library/http.server.html#http.server.BaseHTTPRequestHandler",
    "https://docs.python.org/3/library/__main__.html",
    "https://docs.pytest.org/en/stable/explanation/goodpractices.html#test-discovery"
  ],
  "placement": {
    "root": "tests",
    "test_data_dirs": ["__snapshots__", "golden", "goldens"],
    "fixtures_dir": "fixtures",
    "support_dir": "support",
    "beside_code": true
  },
  "test_support_files": ["conftest.py"],
  "comment_syntax": {
    "line": ["#"]
  }
}
