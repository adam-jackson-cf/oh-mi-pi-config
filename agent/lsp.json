{
  "servers": {
    "pyright": {
      "command": "pyright-langserver"
    },
    "typescript-language-server": {
      "command": "typescript-language-server",
      "initOptions": {
        "tsserver": {
          "fallbackPath": "/home/adam-ai/.omp/node_modules/typescript/lib/tsserver.js"
        }
      }
