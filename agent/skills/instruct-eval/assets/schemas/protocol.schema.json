{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "instruction",
    "provider",
    "model",
    "thinking",
    "trials_per_condition",
    "practical_effect_threshold",
    "significance_level",
    "timeout_seconds",
    "permissions",
    "design_review",
    "scenarios",
    "decision_rules",
    "conditions",
    "execution",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "thinking": {
      "type": "string",
      "minLength": 1
    },
    "trials_per_condition": {
      "type": "integer",
      "minimum": 1
    },
    "practical_effect_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "significance_level": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "design_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_behavior",
        "competing_behavior",
        "candidate_injection_point",
        "falsifiable_hypothesis",
        "architecture_leak_review"
      ],
      "properties": {
        "desired_behavior": {"type": "string", "minLength": 1},
        "competing_behavior": {"type": "string", "minLength": 1},
        "candidate_injection_point": {"type": "string", "minLength": 1},
        "falsifiable_hypothesis": {"type": "string", "minLength": 1},
        "architecture_leak_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved", "rationale"],
          "properties": {
            "approved": {"const": true},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "fixture",
          "failure_mechanism",
          "public_behavior",
          "hidden_invariants",
          "disallowed_shortcuts",
          "initial_request",
          "checkpoints",
          "public_tests",
          "hidden_tests",
          "rubric"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "shortcut",
              "change",
              "overcorrection"
            ]
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "failure_mechanism": {"type": "string", "minLength": 1},
          "public_behavior": {"type": "string", "minLength": 1},
          "hidden_invariants": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "disallowed_shortcuts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "initial_request": {
            "type": "string",
            "minLength": 1
          },
          "checkpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "request"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "request": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "public_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "command",
                "expected_outcome"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "expected_outcome": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                }
              }
            }
          },
          "hidden_tests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "command",
                "expected_outcome",
                "oracle_expected_outcome",
                "fixture"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "pristine",
                    "complete-reference",
                    "plausible-failure"
                  ]
                },
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "expected_outcome": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "oracle_expected_outcome": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "fixture": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "pristine"
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "complete-reference"
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "plausible-failure"
                    }
                  }
                },
                "minContains": 1
              }
            ]
          },
          "rubric": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "preferred_architecture",
              "archetypes",
              "dimensions"
            ],
            "properties": {
              "preferred_architecture": {
                "type": "string",
                "minLength": 1
              },
              "archetypes": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "behavior_preserved",
                  "change_locality",
                  "separation_of_concerns",
                  "unnecessary_abstraction"
                ],
                "properties": {
                  "behavior_preserved": {
                    "type": "string",
                    "minLength": 1
                  },
                  "change_locality": {
                    "type": "string",
                    "minLength": 1
                  },
                  "separation_of_concerns": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unnecessary_abstraction": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "shortcut"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "change"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "overcorrection"
              }
            }
          },
          "minContains": 1
        }
      ]
    },
    "decision_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "behavior_preservation",
        "reproducibility",
        "checkpoint_effect",
        "control"
      ],
      "properties": {
        "behavior_preservation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_candidate_rate",
            "maximum_regression"
          ],
          "properties": {
            "minimum_candidate_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maximum_regression": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_trials"
          ],
          "properties": {
            "minimum_trials": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "checkpoint_effect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "minimum_delta"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "minimum_delta": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "minimum_preferred_rate_delta"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "minimum_preferred_rate_delta": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instruction"
          ],
          "properties": {
            "instruction": {
              "type": "string"
            }
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instruction"
          ],
          "properties": {
            "instruction": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_template",
        "checkpoint_template",
        "scorer_template",
        "rubric_template",
        "score_schema"
      ],
      "properties": {
        "initial_template": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_template": {
          "type": "string",
          "minLength": 1
        },
        "scorer_template": {
          "type": "string",
          "minLength": 1
        },
        "rubric_template": {
          "type": "string",
          "minLength": 1
        },
        "score_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_mode",
        "tools"
      ],
      "properties": {
        "approval_mode": {
          "enum": [
            "always-ask",
            "write",
            "yolo"
          ]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  }
}
