{
  "schema_version": 1,
  "rules": [
    {
      "id": "STRUCT.dependency-direction",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "target_layer_dependency_allowlist_required": true,
        "reject_unmapped_or_forbidden_dependency_edges": true,
        "diagnostic_names_file_edge_and_fix": true
      },
      "summary": "Reject dependencies outside the target's declared layer direction.",
      "reference": [
        {"subcommand": "path-check", "module": "omp_guardrails.structure.paths"},
        {"subcommand": "structure", "module": "omp_guardrails.structure.layout"}
      ]
    },
    {
      "id": "STRUCT.folder-placement",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "target_path_ownership_map_required": true,
        "reject_unmapped_or_misplaced_files": true,
        "diagnostic_names_file_and_destination": true,
        "grab_bag_folder_words_source": "house_style_banned_words"
      },
      "summary": "Require files to live under their declared capability owner.",
      "reference": [
        {"subcommand": "path-check", "module": "omp_guardrails.structure.paths"},
        {"subcommand": "structure", "module": "omp_guardrails.structure.layout"}
      ]
    },
    {
      "id": "NAME.conventions",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "target_path_and_symbol_naming_patterns_required": true,
        "reject_nonmatching_names": true,
        "diagnostic_names_file_and_correct_name": true
      },
      "summary": "Enforce the target's explicit file, folder, and symbol naming conventions.",
      "reference": [
        {"subcommand": "naming", "module": "omp_guardrails.structure.naming"}
      ]
    },
    {
      "id": "TEST.placement",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "target_test_to_owner_and_tier_map_required": true,
        "reject_unmapped_or_misplaced_tests": true,
        "diagnostic_names_file_and_destination": true,
        "fixtures_and_support_under_profile_layout": true,
        "t2_files_map_to_profile_ownership_areas": true
      },
      "summary": "Place tests with their declared behavior owner and test tier.",
      "reference": [
        {"subcommand": "path-check", "module": "omp_guardrails.structure.paths"}
      ]
    },
    {
      "id": "TEST.budget.fast-tier-time",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "git_hook",
      "contract": {
        "input": "normalised_junit_run_report",
        "limit_source": "profile_fast_tier_budget_machines",
        "machine_id": "deterministic_local_probe_of_platform_cpu_model_and_runtime_version",
        "baseline_runs_min": 5,
        "limit_increase_requires_owner_approval": true,
        "local_commit_blocks_over_approved_limit": true,
        "gate": "local_commit_only",
        "ci_never_measures_or_reports_timing": true,
        "unknown_machine_report_only_with_record_baseline_prompt": true,
        "missing_invalid_or_stale_report_is_failure": true,
        "measurement": "fast_tier_wall_clock_seconds"
      },
      "summary": "Block a local commit when the fast tier exceeds the machine's approved wall-clock limit.",
      "reference": [
        {"subcommand": "budget-check", "module": "omp_guardrails.test_evidence.budgets"}
      ]
    },
    {
      "id": "TEST.budget.per-test-time",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "git_hook",
      "contract": {
        "input": "normalised_junit_run_report",
        "limit_source": "profile_fast_tier_budget_machines",
        "machine_id": "deterministic_local_probe_of_platform_cpu_model_and_runtime_version",
        "baseline_runs_min": 5,
        "limit_increase_requires_owner_approval": true,
        "local_commit_blocks_over_approved_limit": true,
        "gate": "local_commit_only",
        "ci_never_measures_or_reports_timing": true,
        "unknown_machine_report_only_with_record_baseline_prompt": true,
        "missing_invalid_or_stale_report_is_failure": true,
        "scope": "fast_tier_test_cases",
        "diagnostic_names_test_and_speedup_fix_never_tier_move": true
      },
      "summary": "Block a local commit when a fast-tier test exceeds the machine's approved per-test limit.",
      "reference": [
        {"subcommand": "budget-check", "module": "omp_guardrails.test_evidence.budgets"}
      ]
    },
    {
      "id": "TEST.growth.justified",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "scope": "new_test_functions_relative_to_base_ref",
        "inline_behaviour_comment_required": true,
        "comment_uses_language_comment_syntax": true,
        "one_comment_per_function_covers_parameter_rows": true,
        "presence_only_placeholder_text_is_failure": true,
        "uncollectable_changed_test_file_is_failure": true,
        "truthfulness_sampled_by_jev_judge_batch_outside_check": true,
        "diagnostic_names_test_and_comment_or_remove_fix": true
      },
      "summary": "Require every added test function to carry an inline behaviour comment.",
      "reference": [
        {"subcommand": "diff-check", "module": "omp_guardrails.diffs.growth"}
      ]
    },
    {
      "id": "TEST.duplicate-path",
      "kind": "bespoke",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "scope": "new_test_cases_relative_to_base_ref",
        "fingerprint": ["normalized_call_path", "normalized_assertion"],
        "compare_with": "existing_and_other_new_test_cases",
        "duplicate_fingerprint_is_failure": true,
        "diagnostic_names_both_tests_and_merge_or_remove_fix": true
      },
      "summary": "Reject new tests duplicating an existing call path and assertion.",
      "reference": [
        {"subcommand": "diff-check", "module": "omp_guardrails.diffs.growth"}
      ]
    },
    {
      "id": "GATE.local-ci-parity",
      "aliases": ["RUNNER.local-ci-parity"],
      "kind": "process",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "configuration": "record:gate.json",
        "schema_version": 2,
        "authoritative_command_field": "checks.ci",
        "required_context_field": "ci.requiredContext",
        "runner_field": "ci.runner",
        "required_context_green_on_exact_head_whoever_posts_it": true,
        "ci_executes_checks_ci_argv_or_parallel_jobs_whose_union_equals_it": true,
        "parallel_jobs_must_use_the_checks_ci_runner_with_tier_selectors_only": true,
        "default_required_context": "gate",
        "parallel_gate_aggregate_depends_on_every_tier_job": true,
        "parallel_gate_aggregate_always_runs": true,
        "parallel_gate_aggregate_fails_on_failed_cancelled_or_skipped_tiers": true,
        "scope": "full_t1_and_t2_suite_on_every_push_and_pull_request",
        "check_only": true,
        "nonzero_exit_propagates": true
      },
      "summary": "Make CI execute exactly the declared checks.ci: the full T1 and T2 suite.",
      "reference": [
        {"subcommand": "toolchain-parity", "module": "omp_guardrails.catalogue.toolchain_parity"}
      ]
    },
    {
      "id": "GATE.pre-commit",
      "kind": "process",
      "applicability": "always",
      "evidence_kind": "git_hook",
      "contract": {
        "configuration": "record:gate.json",
        "required_command_field": "checks.commit",
        "scope": "static_checks_all_t1_and_t2_boundary_tests_for_affected_code",
        "hook_manager": "any_tracked_manager_or_native_hook",
        "installed_pre_commit_hook_executes_exact_checks_commit_argv": true,
        "hook_installed_in_every_clone": true,
        "nonzero_exit_blocks_commit": true
      },
      "summary": "Run checks.commit before every commit through an installed hook and propagate failure."
    },
    {
      "id": "GATE.path-check",
      "kind": "process",
      "applicability": "always",
      "evidence_kind": "local_ci",
      "contract": {
        "configuration": "record:gate.json",
        "required_command_field": "pathCheck",
        "changed_paths_appended_as_arguments": true,
        "success_exit_code": 0,
        "violation_exit_nonzero": true,
        "diagnostic": "one_error_per_line_naming_file_and_fix",
        "checks": ["structure", "naming", "test_placement"]
      },
      "summary": "Expose executable changed-path checks with actionable per-file errors.",
      "reference": [
        {"subcommand": "path-check", "module": "omp_guardrails.structure.paths"}
      ]
    },
    {
      "id": "FANOUT.general",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "count": "distinct_non_stdlib_architectural_imports",
        "max_non_stdlib_dependencies": 10
      },
      "summary": "Bound non-stdlib architectural imports.",
      "reference": [
        {"subcommand": "python-fanout", "module": "omp_guardrails.python_policy.fanout"}
      ]
    },
    {
      "id": "FANOUT.large-module",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "nloc_over": 800,
        "count": "distinct_non_stdlib_architectural_imports",
        "max_non_stdlib_dependencies": 3
      },
      "summary": "Use a tighter fan-out limit for large modules.",
      "reference": [
        {"subcommand": "python-fanout", "module": "omp_guardrails.python_policy.fanout"}
      ]
    },
    {
      "id": "MYPY.SETTING.exclude",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "target_exclusions_with_non_maintained_path_rationales_required": true,
        "maintained_source_must_not_be_excluded": true
      },
      "summary": "Preserve or deliberately adapt mypy setting exclude."
    },
    {
      "id": "MYPY.SETTING.mypy_path",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "target_maintained_source_roots_required": true,
        "all_maintained_import_roots_must_be_covered": true
      },
      "summary": "Preserve or deliberately adapt mypy setting mypy_path."
    },
    {
      "id": "MYPY.SETTING.python_version",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "target_supported_python_version_required": true
      },
      "summary": "Preserve or deliberately adapt mypy setting python_version."
    },
    {
      "id": "MYPY.SETTING.show_error_codes",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Preserve or deliberately adapt mypy setting show_error_codes."
    },
    {
      "id": "MYPY.follow_imports",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "skip"
      },
      "summary": "Enforce follow_imports typing behavior or target-language equivalent."
    },
    {
      "id": "MYPY.module-overrides",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "target_named_module_overrides_required": true,
        "each_override_requires_missing_stub_or_decorator_evidence": true,
        "unscoped_exceptions_forbidden": true
      },
      "summary": "Scope missing-import and decorator exceptions to named modules."
    },
    {
      "id": "MYPY.package-coverage",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "target_maintained_package_inventory_required": true,
        "all_maintained_packages_must_be_checked": true,
        "package_list_drift_is_failure": true
      },
      "summary": "Type-check every maintained package and fail on package-list drift."
    },
    {
      "id": "MYPY.strict",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Enforce strict typing behavior or target-language equivalent."
    },
    {
      "id": "MYPY.warn_unused_ignores",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "True"
      },
      "summary": "Enforce warn_unused_ignores typing behavior or target-language equivalent."
    },
    {
      "id": "PARITY.dependency-inventory",
      "kind": "process",
      "applicability": "conditional",
      "contract": {
        "declared_analyzer_dependencies_match_install": true
      },
      "summary": "Fail when declared optional analyzer dependencies and installation behavior drift.",
      "reference": [
        {"subcommand": "toolchain-parity", "module": "omp_guardrails.catalogue.toolchain_parity"}
      ]
    },
    {
      "id": "PARITY.install-guidance",
      "kind": "process",
      "applicability": "conditional",
      "contract": {},
      "summary": "Keep documented install commands aligned with the actual installer.",
      "reference": [
        {"subcommand": "toolchain-parity", "module": "omp_guardrails.catalogue.toolchain_parity"}
      ]
    },
    {
      "id": "PARITY.lock-version",
      "kind": "process",
      "applicability": "conditional",
      "contract": {
        "tracked_lockfile": true,
        "version_sync": true
      },
      "summary": "Fail when package metadata and lockfile versions drift.",
      "reference": [
        {"subcommand": "toolchain-parity", "module": "omp_guardrails.catalogue.toolchain_parity"}
      ]
    },
    {
      "id": "PRETTIER.version",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "version": "3.6.2",
        "tracked_markdown_yaml": true
      },
      "summary": "Pin and invoke Prettier for maintained Markdown and YAML."
    },
    {
      "id": "PYQ100",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "target_maintained_roots_required": true
      },
      "summary": "Maintained Python source roots",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ101",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "target_script_name_allowlist_required": true,
        "kebab_case_for_command_scripts": true
      },
      "summary": "Approved script file naming and allowlist",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ102",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "target_canonical_test_groups_required": true,
        "target_must_map_groups": true
      },
      "summary": "Canonical test directory groups",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ103",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "restricted_name_parts": "python-reference/omp_guardrails/data/house-style.json banned_words",
        "target_allowlist_required": true
      },
      "summary": "No unapproved generic directory names",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ104",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "restricted_name_parts": "python-reference/omp_guardrails/data/house-style.json banned_words",
        "target_allowlist_required": true
      },
      "summary": "No unapproved generic module names",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ105",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "snake_case"
      },
      "summary": "Python package directories use snake_case",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ106",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "kebab-case"
      },
      "summary": "Skill directories use kebab-case",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ107",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "style": "snake_case"
      },
      "summary": "Python module names use snake_case",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ200",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_lines": 700
      },
      "summary": "Class length at most 700 lines",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ201",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_public_methods": "profile guardrails.python.class_limits.max_public_methods; off when unset"
      },
      "summary": "Public methods per class at most the profile's approved limit",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ202",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_parameters": 8
      },
      "summary": "Constructor parameters at most 8",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ203",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_attributes": 12
      },
      "summary": "Instance attributes at most 12",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ210",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "approved_base_or_mixin_required": true
      },
      "summary": "Analyzer classes inherit an approved analyzer base or mixin",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ211",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "project_entrypoint_required": true
      },
      "summary": "Project analyzers implement the project entrypoint",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ220",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "approved_subprocess_wrapper_map_required": true
      },
      "summary": "Subprocess calls stay in approved seam wrappers",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ221",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "dynamic_import_adapter_allowlist_required": true
      },
      "summary": "Dynamic imports stay in adapter modules",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ230",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "named_callable_aliases_required": true
      },
      "summary": "Contract callables use named aliases",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ231",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "prohibit_any_collaborator_boundary": true
      },
      "summary": "Collaborator contracts do not use Any",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYQ299",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "parse_error_is_failure": true
      },
      "summary": "Undecodable source fails closed",
      "reference": [
        {"subcommand": "python-quality", "module": "omp_guardrails.python_policy.quality"}
      ]
    },
    {
      "id": "PYS000",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "parse_error_is_failure": true
      },
      "summary": "Unparsable source fails closed",
      "reference": [
        {"subcommand": "python-scalability", "module": "omp_guardrails.python_policy.scalability"}
      ]
    },
    {
      "id": "PYS250",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "max_loop_depth": 2
      },
      "summary": "Nested loop and comprehension depth at most 2",
      "reference": [
        {"subcommand": "python-scalability", "module": "omp_guardrails.python_policy.scalability"}
      ]
    },
    {
      "id": "PYS251",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "approved_seam_required": true
      },
      "summary": "No synchronous filesystem I/O in analyzer-like code",
      "reference": [
        {"subcommand": "python-scalability", "module": "omp_guardrails.python_policy.scalability"}
      ]
    },
    {
      "id": "PYS252",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "approved_seam_required": true
      },
      "summary": "No direct subprocess or environment access in analyzer-like code",
      "reference": [
        {"subcommand": "python-scalability", "module": "omp_guardrails.python_policy.scalability"}
      ]
    },
    {
      "id": "PYS253",
      "kind": "bespoke",
      "applicability": "conditional",
      "contract": {
        "scope": "analyzer_like_code",
        "ownership_marker_required": true
      },
      "summary": "Analyzer-like subsystem has an ownership marker",
      "reference": [
        {"subcommand": "python-scalability", "module": "omp_guardrails.python_policy.scalability"}
      ]
    },
    {
      "id": "RUFF.FORMAT.docstring-code-format",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": true
      },
      "summary": "Enforce the docstring-code-format formatting behavior or equivalent."
    },
    {
      "id": "RUFF.FORMAT.indent-style",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "space"
      },
      "summary": "Enforce the indent-style formatting behavior or equivalent."
    },
    {
      "id": "RUFF.FORMAT.line-ending",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "auto"
      },
      "summary": "Enforce the line-ending formatting behavior or equivalent."
    },
    {
      "id": "RUFF.FORMAT.quote-style",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "value": "double"
      },
      "summary": "Enforce the quote-style formatting behavior or equivalent."
    },
    {
      "id": "RUFF.IGNORES",
      "kind": "tool",
      "applicability": "conditional",
      "contract": {
        "ignore": [
          "E501",
          "D100",
          "D101",
          "D102",
          "D103",
          "D104",
          "D105",
          "D107",
          "B006",
          "B008",
          "A005"
        ],
        "per_file": {
          "__init__.py": ["F401", "F403", "D104"],
          "test_*.py": ["D", "S101", "PLR2004"],
