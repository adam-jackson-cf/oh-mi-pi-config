{
  "schema_version": 2,
  "rules": [
    {
      "id": "SKILL.metadata",
      "evidence_kind": "local_ci",
      "implementation_paths": ["scripts/checks/check_skill_metadata.py"],
      "local_runner": "scripts/checks/run.sh",
      "local_marker": "check_skill_metadata.py",
      "ci_runner": ".github/workflows/gate.yml",
      "ci_marker": "scripts/checks/run.sh",
      "canary": {
        "command": ["python", "scripts/checks/check_skill_metadata.py", "{fixture}"],
        "passing": "tests/fixtures/guardrails/skill-metadata/valid/SKILL.md",
        "violating": "tests/fixtures/guardrails/skill-metadata/name-mismatch/SKILL.md",
        "diagnostic": "SKILL.metadata",
        "timeout_seconds": 30
      }
    },
    {
      "id": "REPO.migration-names",
      "local": true,
      "evidence_kind": "git_hook",
      "implementation_paths": ["scripts/checks/check_migration_names.py"],
      "local_runner": "scripts/checks/run.sh",
      "local_marker": "check_migration_names.py",
      "hook_install_check": {
        "command": ["python", "scripts/checks/check_hook_wiring.py"],
        "diagnostic": "REPO.migration-names: hook installed"
      },
      "canary": {
        "command": ["python", "scripts/checks/check_migration_names.py", "{fixture}"],
        "passing": "tests/fixtures/guardrails/migrations/0001_add_users.sql",
        "violating": "tests/fixtures/guardrails/migrations/add-users-v2.sql",
        "diagnostic": "REPO.migration-names"
      }
    }
  ]
}
