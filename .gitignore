# Ignore OMP runtime and update-managed files by default.
# Add an explicit exception when taking ownership of a new file or directory.
*

!.gitignore
!readme.md
!package.json
!bun.lock
!tsconfig.json
!.pre-commit-config.yaml
!.markdownlint-cli2.jsonc
!oxlint.config.ts

!.github/
.github/*
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci-quality-gates.yml
!.github/workflows/package-audit.yml

!scripts/
scripts/*
!scripts/run-ci-quality-gates.sh

!tools/
tools/*
!tools/oxlint/
tools/oxlint/*
!tools/oxlint/anti-slop/
!tools/oxlint/anti-slop/**

!agent/
agent/*
!agent/AGENTS.md
!agent/WATCHDOG.yml
!agent/config.yml
!agent/lsp.json
!agent/skill-auto-whitelist.json

!agent/skills/
agent/skills/*
!agent/skills/orchestrate/
agent/skills/orchestrate/*
!agent/skills/orchestrate/SKILL.md

# instruct-eval is a standalone project, not an OMP-managed skill.
agent/skills/instruct-eval/

!agent/agents/
agent/agents/*
!agent/agents/completionist.md
!agent/agents/innovation-council.md
!agent/agents/innovation-fable.md
!agent/agents/plan-judge.md
!agent/agents/test-judge.md

!agent/extensions/
agent/extensions/*
!agent/extensions/agent-autocomplete.ts
!agent/extensions/agent-introspection.ts
!agent/extensions/extension-health.ts
!agent/extensions/skill-auto-whitelist.ts


!tests/
tests/*
!tests/agent-autocomplete.test.ts

!.omp/
.omp/*
!.omp/lsp.json

# Generated state inside owned source trees remains runtime-only.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/node_modules/
