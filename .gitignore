# Ignore OMP runtime and update-managed files by default.
# Add an explicit exception when taking ownership of a new file or directory.
*

# Per-repo records (repos/<owner>/<name>/) are personal and never committed: they mean nothing
# to anyone else who takes this config. The device rollout copies them between devices.
/repos/

!.gitignore
!readme.md
!package.json
!bun.lock
!bunfig.toml
!pyproject.toml
!.python-version
!uv.lock
!tsconfig.json
!.editorconfig
!.shellcheckrc
!.prettierrc.json
!.githooks/
.githooks/*
!.githooks/pre-commit
!.markdownlint-cli2.jsonc
!.oxlintrc.json

!.github/
.github/*
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci-quality-gates.yml

!scripts/
scripts/*
!scripts/run-ci-quality-gates.sh
!scripts/check_paths.py
!scripts/check_coverage.py
!scripts/run-test-tier.sh
!scripts/audit-dependencies.sh
!scripts/install-quality-gates.sh
!scripts/ci_gate.py
!scripts/ci-gate-repos.json
!scripts/ci_runner.py
# ci-runners.json is machine config written by device_rollout.py; it stays untracked.
!scripts/device_rollout.py
!scripts/device-rollout-hosts.json

!tools/
tools/*
!tools/oxlint/
tools/oxlint/*
!tools/oxlint/anti-slop/
!tools/oxlint/anti-slop/**

!docs/
!docs/**
!agent/
agent/*
!agent/AGENTS.md
!agent/RULES.md
!agent/config.yml
!agent/lsp.json
!agent/skills/
agent/skills/*
!agent/skills/omp-config-optimise/
!agent/skills/omp-config-optimise/**
!agent/skills/jev-actions/
!agent/skills/jev-actions/**

# instruct-eval is a standalone project, not an OMP-managed skill.
agent/skills/instruct-eval/

!agent/agents/
agent/agents/*
!agent/agents/designer.md
!agent/agents/experiment-design.md
!agent/agents/experiment-peer.md
!agent/agents/innovation-challenger.md
!agent/agents/innovation-council.md
!agent/agents/kiss.md
!agent/agents/operator.md

!agent/extensions/
agent/extensions/*
!agent/extensions/AGENTS.md
!agent/extensions/analyse.ts
!agent/extensions/agent-autocomplete.ts
!agent/extensions/quota-gate.ts
!agent/extensions/extension-health.ts
!agent/extensions/dynaflows/
!agent/extensions/dynaflows/**

!tests/
tests/*
!tests/quota-gate.test.ts
!tests/agent-autocomplete.test.ts
!tests/dynaflows-guards-seams.test.ts
!tests/dynaflows-extension-seams.test.ts
!tests/dynaflows-agent-loop-seams.test.ts
!tests/repo-record-seams.test.ts
!tests/dynaflows-extension.test.ts
!tests/analyse.test.ts
!tests/extension-health.test.ts
!tests/orca-terminal-themes.test.ts
!tests/vitest-reporter.test.ts
!tests/anti-slop-rules-seams.test.ts
!tests/anti-slop-rule-messages.test.ts
!tests/oxlint-config-seams.test.ts
!tests/test_check_paths.py
!tests/test_check_coverage.py
!tests/test_check_coverage_seams.py
!tests/test_tune_threshold.py
!tests/test_experiments.py
!tests/test_experiments_seams.py
!tests/test_gate_scripts_seams.py
!tests/test_ci_gate.py
!tests/test_ci_runner.py
!tests/test_reference_*.py
!tests/test_naming_scope.py
!tests/test_language_packs.py
!tests/test_native_tool_settings.py
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/reference/
!tests/fixtures/reference/**
!tests/test_device_rollout.py
!tests/test_repo_record.py
!tests/repo-record.test.ts
!tests/test_skill_references.py
!tests/test_test_enforcement.py
!tests/test_delivery_policy.py
!tests/test_workflows.py
!tests/test_orca_install_seams.py
!tests/test_workflows_seams.py
!tests/test_device_rollout_seams.py
!tests/test_repo_record_seams.py
!tests/test_migrate_records_to_mode_file.py
!tests/test_skill_references_seams.py

!.omp/
.omp/*
!.omp/lsp.json
!.omp/AGENTS.md

!.devcontainer/
.devcontainer/*
!.devcontainer/devcontainer.json
!.devcontainer/Containerfile

# Orca chat styling: injected CSS, palettes, harness and the matching theme plugin.
!orca-plugins/
!orca-plugins/**

# Style choices belong to this machine, not the shared configuration.
orca-plugins/chat-section-style/mode
orca-plugins/chat-section-style/palette
orca-plugins/chat-section-style/terminal-mode
orca-plugins/chat-section-style/terminal-palette

# Generated state inside owned source trees remains runtime-only.
**/.DS_Store
**/__pycache__/
**/.venv/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
agent/extensions/dynaflows/engine/build/
**/node_modules/
orca-plugins/terminal-sections/terminal/
