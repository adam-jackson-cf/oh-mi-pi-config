# Ignore OMP runtime and update-managed files by default.
# Add an explicit exception when taking ownership of a new file or directory.
*

# Per-repo records (repos/<owner>/<name>/) are personal and never committed: they mean nothing
# to anyone else who takes this config. The device rollout copies them between devices.
/repos/

!.gitignore
!readme.md
!package.json
!bun.lock
!bunfig.toml
!tsconfig.json
!.githooks/
.githooks/*
!.githooks/pre-commit
!.markdownlint-cli2.jsonc
!oxlint.config.ts

!.github/
.github/*
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci-quality-gates.yml
!.github/workflows/package-audit.yml

!scripts/
scripts/*
!scripts/run-ci-quality-gates.sh
!scripts/check-paths.py
!scripts/ci-gate.py
!scripts/ci-gate-repos.json
!scripts/ci-runner.py
# ci-runners.json is machine config written by device-rollout.py; it stays untracked.
!scripts/device-rollout.py
!scripts/device-rollout-hosts.json

!tools/
tools/*
!tools/oxlint/
tools/oxlint/*
!tools/oxlint/anti-slop/
!tools/oxlint/anti-slop/**

!adr/
adr/*
!agent/
agent/*
!agent/AGENTS.md
!agent/RULES.md
!agent/config.yml
!agent/lsp.json
!agent/agent-rails.yml
!agent/lib/
agent/lib/*
!agent/lib/repo_record.py
!agent/lib/repo-record.ts
!agent/rules/
agent/rules/*
!agent/rules/agent-rails-*.md
!agent/skills/
agent/skills/*
!agent/skills/omp-config-optimise/
!agent/skills/omp-config-optimise/**
!agent/skills/omp-dyna-workflows/
!agent/skills/omp-dyna-workflows/**
!agent/skills/jev-actions/
!agent/skills/jev-actions/**
!agent/skills/setup-repository-guardrails/
!agent/skills/setup-repository-guardrails/**
!agent/skills/coding-guidance/
!agent/skills/coding-guidance/**
!agent/skills/test-guidance/
!agent/skills/test-guidance/**
!agent/skills/git-tool/
!agent/skills/git-tool/**

# instruct-eval is a standalone project, not an OMP-managed skill.
agent/skills/instruct-eval/

!agent/agents/
agent/agents/*
!agent/agents/designer.md
!agent/agents/experiment-design.md
!agent/agents/experiment-peer.md
!agent/agents/innovation-challenger.md
!agent/agents/innovation-council.md
!agent/agents/kiss.md
!agent/agents/operator.md

!agent/extensions/
agent/extensions/*
!agent/extensions/AGENTS.md
!agent/extensions/analyse.ts
!agent/extensions/agent-autocomplete.ts
!agent/extensions/quota-gate.ts
!agent/extensions/extension-health.ts
!agent/extensions/agent-rails.ts

!tests/
tests/*
!tests/quota-gate.test.ts
!tests/agent-autocomplete.test.ts
!tests/agent-rails.test.ts
!tests/test_check_paths.py
!tests/test_ci_gate.py
!tests/test_ci_runner.py
!tests/test_reference_*.py
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/reference/
!tests/fixtures/reference/**
!tests/test_device_rollout.py
!tests/test_repo_record.py
!tests/repo-record.test.ts
!tests/test_skill_references.py

!.omp/
.omp/*
!.omp/lsp.json
!.omp/AGENTS.md

!.devcontainer/
.devcontainer/*
!.devcontainer/devcontainer.json
!.devcontainer/Containerfile

# Orca chat styling: injected CSS, palettes, harness and the matching theme plugin.
!orca-plugins/
!orca-plugins/**

# Style choices belong to this machine, not the shared configuration.
orca-plugins/chat-section-style/mode
orca-plugins/chat-section-style/palette
orca-plugins/chat-section-style/terminal-mode
orca-plugins/chat-section-style/terminal-palette

# Generated state inside owned source trees remains runtime-only.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
agent/skills/setup-repository-guardrails/assets/python-reference/build/
**/node_modules/
orca-plugins/terminal-sections/terminal/
