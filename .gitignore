# Ignore OMP runtime and update-managed files by default.
# Add an explicit exception when taking ownership of a new file or directory.
*

!.gitignore
!readme.md
!package.json
!bun.lock
!bunfig.toml
!tsconfig.json
!.githooks/
.githooks/*
!.githooks/pre-commit
!.markdownlint-cli2.jsonc
!oxlint.config.ts

!.github/
.github/*
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci-quality-gates.yml
!.github/workflows/package-audit.yml

!scripts/
scripts/*
!scripts/run-ci-quality-gates.sh
!scripts/check-paths.py
!scripts/nuc-gate.py
!scripts/nuc-gate-repos.json

!tools/
tools/*
!tools/oxlint/
tools/oxlint/*
!tools/oxlint/anti-slop/
!tools/oxlint/anti-slop/**

!adr/
adr/*
!agent/
agent/*
!agent/AGENTS.md
!agent/config.yml
!agent/lsp.json
!agent/agent-rails.yml
!agent/rules/
agent/rules/*
!agent/rules/agent-rails-*.md
!agent/skills/
agent/skills/*
!agent/skills/create-watchdog/
!agent/skills/create-watchdog/**
!agent/skills/omp-config-optimise/
!agent/skills/omp-config-optimise/**
!agent/skills/omp-dyna-workflows/
!agent/skills/omp-dyna-workflows/**
!agent/skills/jev-actions/
!agent/skills/jev-actions/**
!agent/skills/setup-repository-guardrails/
!agent/skills/setup-repository-guardrails/**

# instruct-eval is a standalone project, not an OMP-managed skill.
agent/skills/instruct-eval/

!agent/agents/
agent/agents/*
!agent/agents/designer.md
!agent/agents/experiment-design.md
!agent/agents/experiment-peer.md
!agent/agents/innovation-challenger.md
!agent/agents/innovation-council.md
!agent/agents/kiss.md
!agent/agents/operator.md
!agent/agents/verifier.md

!agent/extensions/
agent/extensions/*
!agent/extensions/AGENTS.md
!agent/extensions/analyse.ts
!agent/extensions/agent-autocomplete.ts
!agent/extensions/quota-gate.ts
!agent/extensions/extension-health.ts
!agent/extensions/agent-rails.ts

!tests/
tests/*
!tests/quota-gate.test.ts
!tests/agent-autocomplete.test.ts
!tests/agent-rails.test.ts
!tests/test_check_paths.py
!tests/test_nuc_gate.py
!tests/test_python_reference.py
!tests/test_validate_rule_coverage.py

!.omp/
.omp/*
!.omp/lsp.json
!.omp/gate.json

!.devcontainer/
.devcontainer/*
!.devcontainer/devcontainer.json
!.devcontainer/Containerfile

# Generated state inside owned source trees remains runtime-only.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/node_modules/
