# Ignore OMP runtime and update-managed files by default.
# Add an explicit exception when taking ownership of a new file or directory.
*

!.gitignore
!readme.md
!package.json
!bun.lock
!bunfig.toml
!tsconfig.json
!.pre-commit-config.yaml
!.markdownlint-cli2.jsonc
!oxlint.config.ts

!.github/
.github/*
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci-quality-gates.yml
!.github/workflows/package-audit.yml

!scripts/
scripts/*
!scripts/run-ci-quality-gates.sh

!tools/
tools/*
!tools/oxlint/
tools/oxlint/*
!tools/oxlint/anti-slop/
!tools/oxlint/anti-slop/**

!adr/
adr/*
!adr/2026-09-27T141651+0100-jev-deterministic-scope-review.md

!agent/
agent/*
!agent/AGENTS.md
!agent/WATCHDOG.yml
!agent/config.yml
!agent/lsp.json
!agent/jev-policies.json

!agent/skills/
agent/skills/*
!agent/skills/evaluate-jev/
!agent/skills/evaluate-jev/**
!agent/skills/omp-config-optimise/
!agent/skills/omp-config-optimise/**
!agent/skills/workflow-templates/
!agent/skills/workflow-templates/**

# instruct-eval is a standalone project, not an OMP-managed skill.
agent/skills/instruct-eval/

!agent/agents/
agent/agents/*
!agent/agents/completionist.md
!agent/agents/designer.md
!agent/agents/experiment-design.md
!agent/agents/experiment-peer.md
!agent/agents/innovation-challenger.md
!agent/agents/innovation-council.md
!agent/agents/kiss.md
!agent/agents/plan-judge.md
!agent/agents/test-judge.md

!agent/extensions/
agent/extensions/*
!agent/extensions/agent-autocomplete.ts
!agent/extensions/agent-introspection.ts
!agent/extensions/extension-health.ts
!agent/extensions/jev-watchdog.ts
!agent/extensions/jev-guard.ts
!agent/extensions/jev-subagent-policy.ts
!agent/extensions/jev-ask.ts
!agent/extensions/lib/
agent/extensions/lib/*
!agent/extensions/lib/jev.ts
!agent/extensions/lib/jev-auth.ts


!tests/
tests/*
!tests/agent-autocomplete.test.ts
!tests/jev-watchdog.test.ts
!tests/jev-guard.test.ts
!tests/jev-subagent-policy.test.ts
!tests/jev-ask.test.ts
!tests/jev-lab.test.ts

# Jev lab: workbench source is owned; upstream clone, case sets and runs are runtime-only.
!jev-lab/
jev-lab/*
!jev-lab/README.md
!jev-lab/server.ts
!jev-lab/lib/
!jev-lab/lib/**
!jev-lab/public/
!jev-lab/public/**
!jev-lab/scripts/
jev-lab/scripts/*
!jev-lab/scripts/upstream-lab.sh

!.omp/
.omp/*
!.omp/lsp.json

# Generated state inside owned source trees remains runtime-only.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/node_modules/
