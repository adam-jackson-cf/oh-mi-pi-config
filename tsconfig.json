{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["agent/extensions/**/*.ts", "agent/hooks/**/*.ts"],
  "exclude": [
    "agent/extensions/agent-introspection.ts",
    "agent/extensions/orca*.ts"
  ]
}
