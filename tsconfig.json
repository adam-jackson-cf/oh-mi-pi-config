{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  },
  "include": ["agent/extensions/**/*.ts", "agent/hooks/**/*.ts"],
  "exclude": ["agent/extensions/orca*.ts"]
}
