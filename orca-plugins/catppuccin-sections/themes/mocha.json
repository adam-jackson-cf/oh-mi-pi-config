{
  "base": "dark",
  "tokens": {
    "--background": "#1e1e2e",
    "--editor-surface": "#1e1e2e",
    "--foreground": "#cdd6f4",
    "--card": "#181825",
    "--card-foreground": "#cdd6f4",
    "--popover": "#181825",
    "--popover-foreground": "#cdd6f4",
    "--primary": "#cba6f7",
    "--primary-foreground": "#11111b",
    "--secondary": "#313244",
    "--secondary-foreground": "#cdd6f4",
    "--muted": "#313244",
    "--muted-foreground": "#80b5d5",
    "--accent": "#45475a",
    "--accent-foreground": "#cdd6f4",
    "--border": "#45475a",
    "--input": "#585b70",
    "--ring": "#b4befe",
    "--chart-1": "#cba6f7",
    "--chart-2": "#89b4fa",
    "--chart-3": "#a6e3a1",
    "--chart-4": "#fab387",
    "--chart-5": "#f5c2e7",
    "--sidebar": "#181825",
    "--sidebar-foreground": "#cdd6f4",
    "--sidebar-primary": "#cba6f7",
    "--sidebar-primary-foreground": "#11111b",
    "--sidebar-accent": "#313244",
    "--sidebar-accent-foreground": "#cdd6f4",
    "--sidebar-border": "#11111b",
    "--sidebar-ring": "#b4befe",
    "--worktree-sidebar": "#11111b",
    "--worktree-sidebar-foreground": "#cdd6f4",
    "--worktree-sidebar-accent": "#313244",
    "--worktree-sidebar-accent-foreground": "#cdd6f4",
    "--worktree-sidebar-border": "#11111b",
    "--worktree-sidebar-ring": "#b4befe",
    "--chat-user-message": "#40446a"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Symbols and atoms",
      "scope": [
        "constant.other.symbol",
        "constant.other.atom"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eba0ac",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "variable.language",
        "support.function.builtin",
        "support.variable"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f9e2af",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Macros",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#f5e0dc"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9399b2"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9399b2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f38ba8"
      }
    }
  ]
}
