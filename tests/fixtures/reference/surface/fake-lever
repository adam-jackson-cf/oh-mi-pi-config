#!/usr/bin/env python3
"""A stand-in lever for the SURFACE.lever-isolation self-test.

usage: fake-lever --mode MODE [doctor] --data-dir DIR --evidence-dir DIR

Doctor treats an unusable data directory (missing, or a regular file) as an environment
failure. Modes:
  good         well-behaved: marker on failure, evidence kept, nothing left running
  no-marker    doctor failure without the marker
  blind        doctor passes even when the data directory is unusable
  leak         leaves a child in its own process group
  escape       leaves a child in a new session whose command line names the data directory
  no-evidence  never creates the evidence directory
"""

import argparse
import subprocess
import sys
from pathlib import Path

MARKER = "LEVER-DOCTOR-FAILED"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", default="good")
    parser.add_argument("--data-dir", required=True)
    parser.add_argument("--evidence-dir", required=True)
    parser.add_argument("action", nargs="?", default="doctor")
    options = parser.parse_args()
    if options.mode != "no-evidence":
        Path(options.evidence_dir).mkdir(parents=True, exist_ok=True)
    sleeper = [sys.executable, "-c", "import time; time.sleep(60)", options.data_dir]
    if options.mode == "leak":
        subprocess.Popen(sleeper, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if options.mode == "escape":
        subprocess.Popen(
            sleeper,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    usable = Path(options.data_dir).is_dir()
    if usable or options.mode == "blind":
        print("doctor: ready")
        return 0
    if options.mode == "no-marker":
        print("doctor: something went wrong")
    else:
        print(f"{MARKER}: data directory {options.data_dir} is not usable")
    return 3


if __name__ == "__main__":
    sys.exit(main())
