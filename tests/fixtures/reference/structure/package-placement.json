{
  "about": "Code-folder and package layouts for STRUCT.runtime-data-placement and STRUCT.entry-point-placement: each case lists the head inventory, the changed paths (all of the inventory when omitted), an optional profile and the expected [rule, path] findings after record exceptions.",
  "cases": [
    {
      "name": "runtime data inside a code package",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/pricing.py",
        "src/shop/rules/policy.yaml",
        "src/shop/rules/limits.toml",
        "src/shop/render/__init__.py",
        "src/shop/render/templates/page.html.j2",
        "src/shop/render/templates/mail.jinja",
        "src/shop/render/questions.jsonl"
      ],
      "findings": [
        [
          "STRUCT.runtime-data-placement",
          "src/shop/rules/policy.yaml"
        ],
        [
          "STRUCT.runtime-data-placement",
          "src/shop/rules/limits.toml"
        ],
        [
          "STRUCT.runtime-data-placement",
          "src/shop/render/templates/page.html.j2"
        ],
        [
          "STRUCT.runtime-data-placement",
          "src/shop/render/templates/mail.jinja"
        ],
        [
          "STRUCT.runtime-data-placement",
          "src/shop/render/questions.jsonl"
        ]
      ]
    },
    {
      "name": "data in folders without Python, and non-data files inside code",
      "inventory": [
        "pyproject.toml",
        "noxfile.py",
        "data/catalog.json",
        "data/schemas/order.json",
        "config/settings.toml",
        "src/shop/__init__.py",
        "src/shop/README.md",
        "src/shop/py.typed",
        "src/shop/pricing.py"
      ],
      "findings": []
    },
    {
      "name": "a folder of Python modules without __init__.py is code too",
      "inventory": [
        "tools/gen/render.py",
        "tools/gen/templates/page.jinja",
        "tools/gen/templates/mail.j2",
        "scripts/report.py",
        "scripts/report.yaml",
        "tools/packed/setup.py",
        "tools/packed/defaults.toml"
      ],
      "findings": [
        [
          "STRUCT.runtime-data-placement",
          "tools/gen/templates/page.jinja"
        ],
        [
          "STRUCT.runtime-data-placement",
          "tools/gen/templates/mail.j2"
        ],
        [
          "STRUCT.runtime-data-placement",
          "scripts/report.yaml"
        ]
      ]
    },
    {
      "name": "test and fixture folders hold data and runners freely",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/engine/__init__.py",
        "src/shop/engine/tests/__init__.py",
        "src/shop/engine/tests/cases.json",
        "src/shop/engine/fixtures/__init__.py",
        "src/shop/engine/fixtures/__main__.py",
        "src/shop/engine/fixtures/order.yaml",
        "src/shop/engine/harness/__init__.py",
        "src/shop/engine/harness/cli.py",
        "src/shop/engine/harness/seed.json",
        "tests/fixtures/order.json",
        "tests/__init__.py"
      ],
      "profile": {
        "layout": {
          "support_dir": "src/shop/engine/harness"
        }
      },
      "findings": []
    },
    {
      "name": "a bundle manifest ends the package search",
      "inventory": [
        "shared/__init__.py",
        "shared/core.py",
        "shared/skills/research/SKILL.md",
        "shared/skills/research/assets/domain-map.json",
        "shared/tools/runner/pyproject.toml",
        "shared/tools/runner/runner.toml",
        "shared/settings.json"
      ],
      "findings": [
        [
          "STRUCT.runtime-data-placement",
          "shared/settings.json"
        ]
      ]
    },
    {
      "name": "entry modules in the package folder or a folder directly under it",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/__main__.py",
        "src/shop/cli.py",
        "src/shop/commands/__init__.py",
        "src/shop/commands/cli.py",
        "src/shop/commands/__main__.py"
      ],
      "findings": []
    },
    {
      "name": "entry modules below the top tier",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/engine/__init__.py",
        "src/shop/engine/jobs/__init__.py",
        "src/shop/engine/jobs/__main__.py",
        "src/shop/engine/jobs/runner/__init__.py",
        "src/shop/engine/jobs/runner/cli.py",
        "src/shop/engine/jobs/main.py"
      ],
      "findings": [
        [
          "STRUCT.entry-point-placement",
          "src/shop/engine/jobs/__main__.py"
        ],
        [
          "STRUCT.entry-point-placement",
          "src/shop/engine/jobs/runner/cli.py"
        ]
      ]
    },
    {
      "name": "script folders and broken package chains have their own top tier",
      "inventory": [
        "tools/report/deep/cli.py",
        "src/shop/__init__.py",
        "src/shop/engine/__init__.py",
        "src/shop/engine/plugins/vendor/__init__.py",
        "src/shop/engine/plugins/vendor/cli.py"
      ],
      "findings": []
    },
    {
      "name": "an owner exception exempts an internal tool and nothing else",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/scoring/__init__.py",
        "src/shop/scoring/snapshot_tool/__init__.py",
        "src/shop/scoring/snapshot_tool/cli.py",
        "src/shop/scoring/export/__init__.py",
        "src/shop/scoring/export/cli.py",
        "src/shop/scoring/snapshot_tool/limits.json"
      ],
      "profile": {
        "guardrails": {
          "exceptions": [
            {
              "rule": "STRUCT.entry-point-placement",
              "path": "src/shop/scoring/snapshot_tool",
              "reason": "internal measurement tool the scorer runs in its pinned tool env"
            }
          ]
        }
      },
      "findings": [
        [
          "STRUCT.entry-point-placement",
          "src/shop/scoring/export/cli.py"
        ],
        [
          "STRUCT.runtime-data-placement",
          "src/shop/scoring/snapshot_tool/limits.json"
        ]
      ]
    },
    {
      "name": "only changed paths are judged",
      "inventory": [
        "src/shop/__init__.py",
        "src/shop/rules/legacy.yaml",
        "src/shop/rules/added.yaml"
      ],
      "paths": [
        "src/shop/rules/added.yaml"
      ],
      "findings": [
        [
          "STRUCT.runtime-data-placement",
          "src/shop/rules/added.yaml"
        ]
      ]
    }
  ]
}
